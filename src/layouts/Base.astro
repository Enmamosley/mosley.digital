---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import theme from "@/config/theme.json";
import SmoothScroll from "@/helpers/SmoothScroll";
import { plainify } from "@/lib/utils/textConverter";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import CookieBanner from "./partials/CookieBanner.astro";
import Footer from "./partials/Footer.astro";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  date?: Date;
  tags?: string[];
}

// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical, date, tags } =
  Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID || config.google_tag_manager.gtm_id;
const gtmEnabled =
  config.google_tag_manager.enable &&
  !!gtmId &&
  !gtmId.includes("XXXXXX") &&
  /^GTM-[A-Z0-9]+$/i.test(gtmId);

const siteUrl = config.site.base_url;
const canonicalUrl = canonical || Astro.url.href;
const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
).trim();
const pageDescription = plainify(
  description ? description : config.metadata.meta_description,
).trim();

// absolute image URL for OG/Twitter — ensure leading slash so it resolves
// against the site root (config.meta_image has no leading slash)
const rawImage = image ? image : config.metadata.meta_image;
const ogImageUrl = `${siteUrl}${rawImage.startsWith("/") ? rawImage : `/${rawImage}`}`;

const isArticle = !!date;
const socialLinks = (social.main ?? [])
  .map((s) => s.link)
  .filter(Boolean);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.site.title,
  url: siteUrl,
  logo: `${siteUrl}${config.site.logo}`,
  email: config.params.mail,
  telephone: config.params.phone,
  sameAs: socialLinks,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.site.title,
  url: siteUrl,
  description: config.metadata.meta_description,
  inLanguage: "es-MX",
};

const articleSchema = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: pageTitle,
      description: pageDescription,
      image: ogImageUrl,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      datePublished: date.toISOString(),
      author: {
        "@type": "Organization",
        name: config.site.title,
        url: siteUrl,
      },
      publisher: {
        "@type": "Organization",
        name: config.site.title,
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}${config.site.logo}`,
        },
      },
      keywords: (tags ?? []).join(", "),
      inLanguage: "es-MX",
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- google tag manager -->
    {
      gtmEnabled && <GoogleTagmanager id={gtmId} />
    }
    <!-- favicon -->
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="apple-touch-icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="mosley-digital-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta property="og:title" content={pageTitle} />

    <!-- og-description -->
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="es_MX" />

    {
      isArticle && (
        <>
          <meta property="article:published_time" content={date.toISOString()} />
          <meta property="article:author" content={config.site.title} />
          {tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- twitter-title -->
    <meta name="twitter:title" content={pageTitle} />

    <!-- twitter-description -->
    <meta name="twitter:description" content={pageDescription} />

    <!-- og-image -->
    <meta property="og:image" content={ogImageUrl} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      gtmEnabled && <GoogleTagmanagerNoscript id={gtmId} />
    }

    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="bg-body relative z-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <SmoothScroll client:load />
  </body>
</html>
